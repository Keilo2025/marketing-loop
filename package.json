{
  "name": "marketing-loop",
  "version": "0.3.0",
  "description": "A marketing copy loop for vibe-coding agents. Reads your code, works out what the product actually solves, rewrites the copy to sell the outcome instead of the feature, and only ships it after a human approves it on a canvas.",
  "type": "module",
  "license": "MIT",
  "author": "Christian Buchholz",
  "homepage": "https://github.com/keilo2000/marketing-loop#readme",
  "bugs": {
    "url": "https://github.com/keilo2000/marketing-loop/issues"
  },
  "keywords": [
    "marketing",
    "copywriting",
    "conversion",
    "cro",
    "landing-page",
    "cta",
    "claude-code",
    "cursor",
    "codex",
    "agents",
    "ai-agent",
    "plugin",
    "vibe-coding"
  ],
  "bin": {
    "marketing-loop": "dist/cli.js",
    "mloop": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./psychology": "./dist/core/psychology.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"tests/**/*.test.js\"",
    "loop": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keilo2000/marketing-loop.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
